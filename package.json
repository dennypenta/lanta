{
  "name": "lanta",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --cwd packages/api --hot --env-file=packages/api/.env.local dev",
    "dev:web": "bun --cwd packages/web --hot dev",
    "dev": "bun --parallel dev:api dev:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:generate": "bun --cwd packages/api migrate:generate",
    "migrate:migrate": "cd packages/api && export $(cat .env.local | xargs) && npx drizzle-kit migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.5",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@orpc/client": "^1.13.2",
    "@orpc/server": "^1.13.2"
  }
}

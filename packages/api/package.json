{
  "name": "@lanta/api",
  "type": "module",
  "scripts": {
    "dev": "bun --watch index.ts",
    "build": "bun build index.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun dist/index.js",
    "migrate:generate": "drizzle-kit generate",
    "migrate:migrate": "bun --env-file=.env.local drizzle-kit migrate"
  },
  "dependencies": {
    "@lanta/rpc": "workspace:*",
    "better-auth": "^1.4.10",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.22",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.10",
    "@types/bun": "^1.3.6",
    "better-sqlite3": "^12.6.0",
    "drizzle-kit": "^0.31.8"
  }
}

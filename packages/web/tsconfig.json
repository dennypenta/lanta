{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Solid.js specific
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    // Include DOM types for browser environment
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // Additional types for Vite
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
